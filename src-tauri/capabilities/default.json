{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"opener:default",
		"http:default",
		{
			"identifier": "http:default",
			"allow": [
				{
					"url": "https://**"
				},
				{
					"url": "http://**"
				}
			]
		},
		"deep-link:default",
		"google-auth:default",
		"fs:default",
		"fs:allow-appdata-write-recursive",
		"fs:allow-appdata-read-recursive"
	]
}
